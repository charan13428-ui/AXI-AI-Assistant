{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "JARVIS desktop companion for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "JARVIS",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "style.css",
      "package.json"
    ]
  }
}